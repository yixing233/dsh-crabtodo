{
  "name": "dsh-crabtodo",
  "version": "0.2.5",
  "description": "CrabTodo — a persistent todo manager for DeepSeek Harness: model-facing todo tools backed by a JSON store under $DSH_HOME, plus a full sidebar page in the Web UI. 持久化待办插件：模型可增删改查的 todo 工具 + Web 侧边栏任务页面。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "skills"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-web",
    "todo",
    "todos",
    "task",
    "tasklist",
    "todo-list",
    "待办",
    "任务管理",
    "清单"
  ],
  "engines": {
    "node": ">=22",
    "dsh": "0.1.7-rc.1 || 0.1.7-rc.2 || 0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yixing233/dsh-crabtodo.git"
  },
  "homepage": "https://github.com/yixing233/dsh-crabtodo#readme",
  "bugs": {
    "url": "https://github.com/yixing233/dsh-crabtodo/issues"
  },
  "compatibility": {
    "dshReleases": {
      "0.1.7-rc.1": "compatible",
      "0.1.7-rc.2": "compatible",
      "0.2.0-rc.1": "compatible",
      "0.2.0-rc.2": "compatible",
      "0.2.1-rc.1": "compatible",
      "0.2.1-rc.2": "compatible"
    }
  }
}
